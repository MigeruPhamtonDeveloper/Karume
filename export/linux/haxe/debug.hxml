-main ApplicationMain 
-cp /home/anderson/haxe/haxe_libraries/flixel/6.2.0/haxelib
-D flixel=6.2.0
-cp /home/anderson/haxe/haxe_libraries/openfl/9.5.2/haxelib/src
-D openfl=9.5.2
--macro openfl.utils._internal.ExtraParamsMacro.include()
-cp /home/anderson/haxe/haxe_libraries/lime/8.3.2/haxelib/src
-D lime=8.3.2
--macro lime._internal.macros.DefineMacro.run()
--macro haxe.macro.Compiler.addMetadata("@:autoBuild(lime._internal.macros.AssetsMacro.embedBytes())", "haxe.io.Bytes")
-cp source
-D lime-openal
-D message.reporting=pretty
-D native
-D lime-openalsoft
-D lime-curl
-D openfl-native
-D FLX_NO_HEALTH
-D lime-harfbuzz
-D lime-threads
-D tools=8.3.2
-D lime-cairo
-D lime-threads-deque
-D FLX_NO_DEBUG
-D lime-opengl
-D no-compilation
-D NAPE_RELEASE_BUILD
-D FLX_NO_TOUCH
-D lime-native
-D lime-vorbis
-D lime-cffi
-D linux
-D desktop
--remap flash:openfl
--macro flixel.system.macros.FlxDefines.run()
-cpp export/linux/obj/
-cp export/linux/haxe
--macro keep("Main")
-debug
